# Copy to .env and fill in. Never commit .env.

# Required outside debug/testing: a long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Database: either a single URL ...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lostlocker
# ... or the individual parts (used only when DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=lostlocker
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false

# Where uploaded photos are stored (default: <instance folder>/uploads)
# UPLOAD_FOLDER=/var/lib/lostlocker/uploads

# Public URL, used for links in notification emails
BASE_URL=http://localhost:5000

# Match notification emails. Leave MAIL_SERVER empty to log them instead of sending.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=lostlocker@example.com

# Minimum match score for a lost/found pair to be reported (see lostlocker/matching.py)
MATCH_MIN_SCORE=1.5

# Optional: only allow registration with this email domain (e.g. sandiego.edu)
ALLOWED_EMAIL_DOMAIN=

# Make an account an admin with:  flask --app lostlocker make-admin you@example.com
